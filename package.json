{
  "name": "contract-rater",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "eval": "pnpm --filter @rater/evals eval",
    "dev:api": "pnpm --filter @rater/api dev",
    "dev:worker": "pnpm --filter @rater/worker dev",
    "dev:web": "pnpm --filter @rater/web dev",
    "db:generate": "pnpm --filter @rater/db generate",
    "db:migrate": "pnpm --filter @rater/db migrate",
    "law:ingest": "pnpm --filter @rater/law ingest",
    "dev:db": "docker compose -f infra/docker-compose.yml up -d postgres",
    "docker:up": "docker compose -f infra/docker-compose.yml up --build -d --wait",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
