# Contract Rater settings. Every variable the API, the worker and the web dev server read.
#
# Only DATABASE_URL is required for local development; everything else has a default.
# Nothing loads this file automatically. Copy it to .env, then export it in your shell before
# you start the apps (from the repository root):
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# An empty value (FOO=) counts as "not set". Never commit .env: it can hold API keys.

# ---------------------------------------------------------------------------------------------
# Shared by the API, the worker and the scripts (pnpm db:migrate)
# ---------------------------------------------------------------------------------------------

# Postgres 16. pg-boss (the job queue) uses the same database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rater

# development (default) | test | production. Production requires BETTER_AUTH_SECRET and, with
# the local storage driver, STORAGE_ENCRYPTION_KEY. Left commented out because an exported
# NODE_ENV also changes `vite build` and the tests.
# NODE_ENV=production

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Apply pending database migrations when the API or the worker starts ("true" or "false").
# Safe when both do it. Set it to false when a separate step migrates, as the Compose stack does.
DB_MIGRATE_ON_START=true

# ---------------------------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------------------------

PORT=3000
HOST=0.0.0.0

# Signs session cookies. At least 32 characters; required in production.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL the browser uses to reach the API. Better Auth builds its links from it.
BETTER_AUTH_URL=http://localhost:3000

# Where the web app is served from. Allowed by CORS and by Better Auth's origin check.
# Vite's dev server (http://localhost:5173) is always allowed outside production.
WEB_ORIGIN=http://localhost:5173

# Uploads per user in any 24 hours, across all their workspaces (429 with Retry-After above
# it). A rejected upload does not count; deleting a rating does not give an upload back.
RATE_LIMIT_PER_DAY=20

# Largest accepted upload, in bytes (10 MB).
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------------------------
# Worker (apps/worker)
# ---------------------------------------------------------------------------------------------

# Ratings processed at the same time by one worker process (1-16).
WORKER_CONCURRENCY=2

# Arabic OCR of Section 15 with tesseract (needs tesseract-ocr-ara). Also off when tesseract or
# its Arabic data is missing.
OCR_ENABLED=true

# ---------------------------------------------------------------------------------------------
# File storage (packages/storage), read by the API and the worker
# ---------------------------------------------------------------------------------------------

# local: encrypted files on disk (development, single-machine pilots). s3: a bucket.
STORAGE_DRIVER=local

# local driver: the folder for the encrypted PDFs. Default: .data/storage in the repository
# root, whichever folder the app runs from, so the API and the worker share it (git and the
# Docker build ignore .data/). If you set it, use an absolute path and the SAME value for both:
# a relative path resolves against each app's own folder (apps/api, apps/worker).
# LOCAL_STORAGE_DIR=/srv/contract-rater/storage

# local driver: AES-256-GCM key, 32 bytes as base64. Required in production. Without it,
# development uses a fixed insecure key and prints a warning.
# Generate one with: openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=

# s3 driver. Every object is written with server-side encryption (AES256); MinIO needs a KMS
# key for that (MINIO_KMS_SECRET_KEY below).
S3_BUCKET=contracts
S3_REGION=us-east-1
# Leave empty for AWS. For MinIO: http://localhost:9000
S3_ENDPOINT=
# true for MinIO and most S3-compatible services.
S3_FORCE_PATH_STYLE=false
# Set both or neither. With neither, the AWS SDK's default chain is used (instance role, ...).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------------------------
# Section 15 analyser (packages/llm), read by the worker and pnpm eval
# ---------------------------------------------------------------------------------------------

# auto (default): Claude when ANTHROPIC_API_KEY is set, the offline heuristic analyser otherwise.
# claude: always Claude (fails without a key). heuristic: always offline, even with a key.
LLM_PROVIDER=auto

# Only redacted contract text is sent. Leave empty to run fully offline.
ANTHROPIC_API_KEY=

# Overrides the pinned Claude model (default claude-opus-5-5). Recorded on every rating.
LLM_MODEL=

# off: do not ask the API for structured outputs (for a model that does not support them).
LLM_STRUCTURED_OUTPUT=

# Another Anthropic-compatible endpoint (a proxy or gateway). Leave empty for the default.
ANTHROPIC_BASE_URL=

# ---------------------------------------------------------------------------------------------
# Traces (OpenTelemetry over OTLP/HTTP), read by the API and the worker. Off when empty.
# ---------------------------------------------------------------------------------------------

# e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Traces only; overrides the endpoint above for the worker.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Defaults: contract-rater-api, contract-rater-worker.
OTEL_SERVICE_NAME=

# ---------------------------------------------------------------------------------------------
# Web dev server (apps/web, pnpm dev:web)
# ---------------------------------------------------------------------------------------------

# Where Vite proxies /api in development and preview.
VITE_API_TARGET=http://localhost:3000

# ---------------------------------------------------------------------------------------------
# Docker Compose only (infra/docker-compose.yml)
#
# Compose reads these from your shell or from infra/.env, not from this folder's .env. The
# stack sets DATABASE_URL, the S3_* values and the URLs above itself. Every value has a local
# default; set your own passwords and keys before you upload a real contract.
# ---------------------------------------------------------------------------------------------

# POSTGRES_PASSWORD=postgres
# MINIO_ROOT_USER=rater
# MINIO_ROOT_PASSWORD=local-only-password
# MinIO's at-rest encryption key: <name>:<32 bytes as base64>.
# Generate one with: echo "rater-key:$(openssl rand -base64 32)"
# MINIO_KMS_SECRET_KEY=
# Another MinIO server image (default pgsty/minio, a community build).
# MINIO_IMAGE=
# Ports published on 127.0.0.1.
# WEB_PORT=8080
# API_PORT=3000
# POSTGRES_PORT=5432
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# Also passed through to the containers: BETTER_AUTH_SECRET, ANTHROPIC_API_KEY, LLM_PROVIDER,
# LLM_MODEL, LLM_STRUCTURED_OUTPUT, OCR_ENABLED, WORKER_CONCURRENCY, RATE_LIMIT_PER_DAY,
# S3_BUCKET, LOG_LEVEL, OTEL_EXPORTER_OTLP_ENDPOINT.
